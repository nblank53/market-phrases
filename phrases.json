        "language": "French",
        "language_code": "fr-FR",
        "emergency_numbers": {"all_emergencies_eu": "112", "medical_samu": "15", "police": "17", "fire": "18"},
        "notes": "Always greet with Bonjour when entering a shop or stall. Many market stalls prefer cash."
      },
      {
        "code": "ch",
        "name": "Switzerland",
        "language": "German (Swiss usage)",
        "language_code": "de-CH",
        "emergency_numbers": {"all_emergencies": "112", "police": "117", "fire": "118", "ambulance": "144"},
        "notes": "German is used in Zurich, Basel, Lucerne and Bern. In Geneva, Lausanne and Montreux use the French set; in Ticino (Lugano) use the Italian set. Swiss spelling uses ss instead of ß. Currency is Swiss francs (CHF), not euros. Cash is common at market stalls."
      },
      {
        "code": "it",
        "name": "Italy",
        "language": "Italian",
        "language_code": "it-IT",
        "emergency_numbers": {"all_emergencies_eu": "112", "ambulance": "118", "police_carabinieri": "112", "fire": "115"},
        "notes": "Use Buongiorno until about midday, then Buonasera. Restaurants may add a small coperto (cover charge). In South Tyrol (Bolzano, Merano) German is also widely spoken."
      }
